# ─────────────────────────────────────────────
#  OTP OCEAN — Environment Variables
#  Copy this file to .env and fill in your values
#  NEVER commit the real .env file to GitHub!
# ─────────────────────────────────────────────

# ── Telegram Bot Credentials ─────────────────
# Get BOT_TOKEN from @BotFather on Telegram
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Get API_ID and API_HASH from https://my.telegram.org
API_ID=12345678
API_HASH=abcdef1234567890abcdef1234567890

# ── Admin & Logging ───────────────────────────
# Your personal Telegram user ID (get it from @userinfobot)
ADMIN_ID=123456789

# ID of a Telegram group/channel where payment logs go
# Must be negative for groups, e.g. -1001234567890
LOG_GROUP=-1001234567890

# ── MongoDB Atlas ─────────────────────────────
# Get from https://cloud.mongodb.com → Connect → Drivers
# Format: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority

# ── Web Server (auto-set by Render/Railway) ───
# Leave as 8080 for local. Render/Railway set this automatically.
PORT=8080

# ── Keep-Alive Self-Ping ──────────────────────
# RENDER: Set this to your Render app URL, e.g. https://otp-ocean.onrender.com
# RAILWAY: Set this to your Railway URL, e.g. https://otp-ocean.up.railway.app
# Leave blank if running locally or on a VPS
APP_URL=
